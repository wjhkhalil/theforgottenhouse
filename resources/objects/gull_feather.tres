[resource]
script = ExtResource("1_data")
object_id = &"gull_feather"
display_name = "Gull Feather"
description = "A long grey-and-white feather, blown in through a window."
collection_message = "You found a gull feather!"
clue_text = "The logbook says the girl collected feathers on the stairs while she got better. She'd sit for hours watching the gulls."
hint_text = "At the very top, on the first iron step down from the top landing. Wait for the beam to light it."
