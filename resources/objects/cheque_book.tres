[gd_resource type="Resource" script_class="HiddenObjectData" format=3]

[ext_resource type="Script" path="res://scripts/hidden_object_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
object_id = &"cheque_book"
display_name = "Cheque Book"
description = "A cheque book, open at the stubs."
collection_message = "You found a cheque book!"
clue_text = "Every stub, month after month for years, says the same thing: 'T.G.'. Vane paid Greaves to keep quiet."
hint_text = "It lies on the desk, by the pile of papers next to the green lamp."
