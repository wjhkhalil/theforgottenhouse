description = "A tapered oak plug, greased and dark with lake water."
collection_message = "You found a wooden bung!"
clue_text = "A spare plug, greased so it would pull out easily. One bung like this can hold back the whole lake, until somebody pulls it."
hint_text = "A small wooden crate sits on the floor under the boat, between the two trestles. Look inside it."
