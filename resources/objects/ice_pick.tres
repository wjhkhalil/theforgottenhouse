[ext_resource type="Script" path="res://scripts/hidden_object_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
object_id = &"ice_pick"
display_name = "Ice Pick"
description = "A long ice pick with a wooden handle and a sharp steel spike."
