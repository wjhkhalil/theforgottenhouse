theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1)
text = "Years ago, the owner of this house disappeared without a trace. Tonight you step inside their old bedroom. Search carefully: they left five things behind, and together they tell a story no one was meant to read."
horizontal_alignment = 1
autowrap_mode = 3

