[node name="Text" type="Label" parent="AboutLayer/Center/Panel/VBox" unique_id=1511778696]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "The Forgotten House is a small hidden-object mystery made with Godot 4.

HOW TO PLAY
- Look around the bedroom and click the hidden objects.
- The list on the right shows what you still need to find.
- Stuck? Press Hint (or H) to see roughly where to look.
- Press Pause (Esc or P) to pause, restart or leave.
- Your progress is saved automatically. Use Continue to carry on.

All artwork in this version is drawn with code as a placeholder."
autowrap_mode = 3

