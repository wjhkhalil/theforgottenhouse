[node name="Text" type="Label" parent="AboutLayer/Center/Panel/VBox" unique_id=1511778696]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "The Forgotten House is a hidden-object mystery set in three abandoned houses: Ashworth Manor, the Blackwater Boathouse and Hollowmere Sanatorium.

HOW TO PLAY
- Search each room and tap or click the hidden objects.
- The Objects to Find list shows what is still missing.
- Open drawers, boxes and cupboards. Some need a code.
- Drag to look around the room, and zoom in for a closer look.
- Stuck? Press Hint to see roughly where to look.
- Your progress is saved automatically."
autowrap_mode = 3

