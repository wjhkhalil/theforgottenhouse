open_message = "Bottles, bandages, and under them a heavy iron key with a tag: 'CELLAR'."
required_code = "1987"
code_title = "Vane's Doctor's Bag"
code_prompt = "A black leather doctor's bag with a brass four-number lock. Scratched on the clasp: 'The year of the lie.'"
code_hint_first = "Wrong. Which lie? The biggest one Vane ever told is written on a certificate in this room."
code_hint_second = "Mara's death certificate, signed by Vane, is dated 1987. The code is 1987."
code_hint_first_after = 9
code_hint_second_after = 12
style = 7
tint = Color(0.1, 0.09, 0.09, 1)
size = Vector2(84, 44)

