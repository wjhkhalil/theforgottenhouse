position = Vector2(790, 612)
container_id = &"desk_safe"
contents = NodePath("../Confession")
open_title = "The dial clicks round to 0810..."
open_message = "The safe door swings open. Inside lie two folded pages in Vane's handwriting."
required_code = "0810"
code_title = "Vane's Desk Safe"
code_prompt = "A small iron safe with a four-number dial. Vane never trusted his memory: he left himself a reminder on the desk."
code_hint_first = "Wrong. Read the card propped against the green lamp, then find that day on the calendar by the cellar door."
code_hint_second = "The calendar has the 8th of October ringed in red: '8th: fetch M.'. Day 08, month 10: the code is 0810."
code_hint_first_after = 9
code_hint_second_after = 12
style = 5
tint = Color(0.18, 0.26, 0.2, 1)
size = Vector2(70, 62)

